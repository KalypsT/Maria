{
  "name": "maria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "check:no-debug": "node scripts/check-no-debug.js",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
